# Hex-encoded private key for Arc Testnet (must hold testnet USDC for transfer and gas)
ARC_PRIVATE_KEY=0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Solana Devnet recipient address (Base58 public key)
SOLANA_RECIPIENT_ADDRESS=EnterYourSolanaDevnetRecipientAddressHere

# Amount of USDC to transfer (e.g. 1.0)
TRANSFER_AMOUNT=1.0
